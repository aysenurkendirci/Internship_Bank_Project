# Copy to .env and replace every value. .env is ignored by git.

# SQL Server requires 8+ characters with upper case, lower case, digits and symbols.
SQL_SA_PASSWORD=Change_Me_123!

# At least 32 random characters, e.g. the output of: openssl rand -base64 48
JWT_KEY=replace-with-a-long-random-secret-of-at-least-32-characters

RABBITMQ_PASSWORD=change-me
