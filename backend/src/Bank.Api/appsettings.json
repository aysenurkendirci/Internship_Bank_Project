{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "BankDb": "Server=localhost;Database=BankDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "BankApi",
    "Audience": "BankClient",
    "ExpiresMinutes": 10
  },
  "Session": {
    "RefreshTokenHours": 8
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Messaging": {
    "Enabled": false,
    "PollInterval": "00:00:02",
    "BatchSize": 50,
    "RabbitMq": {
      "Host": "localhost",
      "Port": 5672,
      "VirtualHost": "/",
      "Exchange": "bank.events"
    }
  },
  "AllowedHosts": "*"
}
